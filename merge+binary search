#include<stdio.h>

void merge(int arr[], int left, int mid, int right) {
    int temp[100]; // temporary array
    int i = left;     // start of left part
    int j = mid + 1;  // start of right part
    int k = 0;        // index for temp

    // Compare and pick smaller
    while (i <= mid && j <= right) {
        if (arr[i] < arr[j])
            temp[k++] = arr[i++]; // pick from left
        else
            temp[k++] = arr[j++]; // pick from right
    }

    // Copy remaining left
    while (i <= mid) temp[k++] = arr[i++];
    // Copy remaining right
    while (j <= right) temp[k++] = arr[j++];

    // Copy temp back to arr
    for (i = left, k = 0; i <= right; i++, k++)
        arr[i] = temp[k]; // final sorted values
}

void mergeSort(int arr[], int left, int right) {
    if (left < right) {
        int mid = (left + right) / 2;
        mergeSort(arr, left, mid);      // sort left part
        mergeSort(arr, mid + 1, right); // sort right part
        merge(arr, left, mid, right);   // merge them
    }
}

int main(){
int n;
printf("Enter number of elements: ");
scanf("%d", &n);
int arr[n];
printf("Enter elements: ");
for(int i = 0; i<n; i++){
    scanf("%d", &arr[i]);
}
int search;
printf("Enter element to search: ");
  scanf("%d", &search);

mergeSort(arr, 0, n - 1);
 printf("Sorted array: ");
 for (int i = 0; i < n; i++){
 printf("%d ", arr[i]);
 }
 printf("\n");

 int minimum, maximum, middle;

//  printf("Enter element to search: ");
//  scanf("%d", &search);

  minimum = 0;
  maximum = n - 1;
  middle = (minimum+maximum)/2;

  while (minimum <= maximum) {

    if (arr[middle] < search)
      minimum = middle + 1;
    else if (arr[middle] == search) {
     // printf("%d found at location %d.\n", search, middle+1);
      printf("Element found at index: %d\n", middle);
      break;
    }
    else
      maximum = middle - 1;

    middle = (minimum + maximum)/2;
  }

if(minimum>maximum)
    printf("element not found");

 return 0;


}



